<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#071C18"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="PERSONAL STATE"
        android:textColor="#96B7AE"
        android:textSize="11sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/heartValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="--"
        android:textColor="#FFFFFF"
        android:textSize="54sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="bpm"
        android:textColor="#56D7A6"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/streamStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:maxLines="2"
        android:text="Battery-safe all-day monitoring"
        android:textColor="#D7E7E2"
        android:textSize="12sp" />

    <Button
        android:id="@+id/streamButton"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:layout_marginTop="12dp"
        android:text="Start 5 min live"
        android:textAllCaps="false" />
</LinearLayout>
